rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDoc) ? get(userDoc).data : {};
    }
    
    function isActive() {
      return isAuthenticated() && getUserData().status == 'active';
    }
    
    function isOwner() {
      return (isAuthenticated() && request.auth.token.email == 'sekhar.root@gmail.com') || (isActive() && getUserData().role == 'owner');
    }

    function isAdminOrOwner() {
      return (isAuthenticated() && request.auth.token.email == 'sekhar.root@gmail.com') || (isActive() && (getUserData().role == 'admin' || getUserData().role == 'owner'));
    }

    function isCoordinator() {
      return isActive() && getUserData().role == 'academic_coordinator';
    }

    function getSchoolId() {
      return getUserData().get('schoolId', '');
    }

    function belongsToSchool(schoolId) {
      return isActive() && schoolId != '' && getSchoolId() == schoolId;
    }

    function isDocTenant(docData) {
      return isActive() && getSchoolId() != '' && docData.get('schoolId', '') == getSchoolId();
    }

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection Group Queries
    match /{path=**}/students/{studentId} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || isDocTenant(request.resource.data);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data));
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }
    
    match /{path=**}/leaves/{leaveId} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || (isDocTenant(request.resource.data) && getUserData().get('hasLeaveFeatureAccess', false) == true);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data) && getUserData().get('hasLeaveFeatureAccess', false) == true);
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }
    
    match /{path=**}/attendance/{date} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || isDocTenant(request.resource.data);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data));
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }

    match /{path=**}/attendance_summary/{date} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || isDocTenant(request.resource.data);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data));
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }

    // Classroom manager collections
    // Only active users can read and write standard collections for now.
    // In a production app, you might restrict this further (e.g. teachers only writing to their own class)
    match /schools/{schoolId} {
      // Anyone can read schools (necessary for the registration dropdown)
      allow read: if true;
      // Only owners/admins can write (add/remove) schools
      allow write: if isAdminOrOwner();

      match /attendance_summaries/{date} {
        allow read, write: if belongsToSchool(schoolId) || isAdminOrOwner();
      }

      match /absentee_summaries/{date} {
        allow read, write: if belongsToSchool(schoolId) || isAdminOrOwner();
      }

      match /classes/{classId} {
        allow read, write: if belongsToSchool(schoolId) || isAdminOrOwner();

        match /students/{studentId} {
          allow read, write: if belongsToSchool(schoolId) || isAdminOrOwner();
        }

        match /leaves/{leaveId} {
          allow read: if belongsToSchool(schoolId) || isAdminOrOwner();
          allow write: if isAdminOrOwner() || (belongsToSchool(schoolId) && getUserData().get('hasLeaveFeatureAccess', false) == true);
        }

        match /attendance/{date} {
          allow read, write: if belongsToSchool(schoolId) || isAdminOrOwner();
        }

        match /attendance_summary/{date} {
          allow read, write: if belongsToSchool(schoolId) || isAdminOrOwner();
        }

        match /monthly_reports/{month} {
          allow read, write: if belongsToSchool(schoolId) || isAdminOrOwner();
        }
      }

      match /monthly_reports/{reportId} {
        allow read, write: if belongsToSchool(schoolId) || isAdminOrOwner();
      }
    }

    match /students/{studentId} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || isDocTenant(request.resource.data);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data));
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }
    
    match /attendance/{date} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || isDocTenant(request.resource.data);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data));
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }

    match /attendance_summaries/{date} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || isDocTenant(request.resource.data);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data));
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }

    match /class_daily_attendance/{docId} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || isDocTenant(request.resource.data);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data));
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }
    
    match /classes/{classId} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || isDocTenant(request.resource.data);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data));
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }

    match /leaves/{leaveId} {
      allow read: if isAdminOrOwner() || isDocTenant(resource.data);
      allow create: if isAdminOrOwner() || (isDocTenant(request.resource.data) && getUserData().get('hasLeaveFeatureAccess', false) == true);
      allow update: if isAdminOrOwner() || (isDocTenant(resource.data) && isDocTenant(request.resource.data) && getUserData().get('hasLeaveFeatureAccess', false) == true);
      allow delete: if isAdminOrOwner() || isDocTenant(resource.data);
    }

    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for UI lists, etc.)
      allow read: if isAuthenticated();
      
      // Creating a user profile during signup:
      // - Admins/Owners can create any pre-configured profile
      // - Self-registration by regular users must strictly default to 'class_teacher' role and 'pending' status
      allow create: if isAuthenticated() && (
        isAdminOrOwner() ||
        (request.auth.uid == userId &&
         request.resource.data.get('role', 'class_teacher') == 'class_teacher' &&
         request.resource.data.get('status', 'pending') == 'pending' &&
         request.resource.data.get('hasLeaveFeatureAccess', false) == false)
      );
                    
      // Updating a user profile
      allow update: if isAuthenticated() && (
        // Admins/Owners can update any profile
        isAdminOrOwner() ||
        // Academic Coordinators can update substitute teacher classes (only for class_teacher accounts to prevent privilege escalation)
        (isCoordinator() && resource.data.role == 'class_teacher') ||
        // Users can update their own profile, BUT they cannot change their role, status, schoolId, or hasLeaveFeatureAccess
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.status == resource.data.status &&
         request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') &&
         request.resource.data.get('hasLeaveFeatureAccess', false) == resource.data.get('hasLeaveFeatureAccess', false))
      );
      
      // Only Admins/Owners can delete users, OR a user can delete their own pre-configured profile
      allow delete: if isAdminOrOwner() || 
                    (isAuthenticated() && userId.matches('^pre_.*') && resource.data.email == request.auth.token.email);
    }
  }
}
